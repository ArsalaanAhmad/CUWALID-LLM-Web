
##$ OPENROUTER / LLM CONFIG

OPENROUTER_API_KEY=insert your OpenRouter API key here

# Model for modelling/help chat (OpenRouter)
LLM_MODEL=qwen/qwen3-235b-a22b-thinking-2507

# Qwen model used by the MCP server
OLLAMA_MODEL=qwen2.5

# Optional sampling temperature
OLLAMA_TEMPERATURE=0.7


### For MCP SERVER CONFIG


# Local MCP server endpoint
# MCP_URL=http://127.0.0.1:8000/sse --not usable right now.

# Tool names exposed by server.py
MCP_EXTRACT_TOOL=extract_to_json
MCP_CHAT_TOOL=ask_qwen



###  APP SETTINGS

# Choose how the chat backend runs
CHAT_PROVIDER=openrouter

# Supported forecast years
MIN_YEAR=2020
MAX_YEAR=2035

# Default language
DEFAULT_LANGUAGE=en


# ==============================
# DATA PATHS
# ==============================

DATA_DIR=./data
MAP_DIR=./maps
MANIFEST_PATH=./manifest.json
CUWALID_DATA_ROOT=data